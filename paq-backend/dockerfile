# ── Stage 1: Build ──────────────────────────────
# Image de construction Maven avec JDK 17 pour compiler l'application.
FROM maven:3.9-eclipse-temurin-17 AS builder

# Définit le répertoire de travail à /app dans l'image builder.
WORKDIR /app

# Copie le fichier pom.xml en premier pour profiter du cache Docker si les dépendances ne changent pas.
COPY pom.xml .
# Télécharge toutes les dépendances Maven en mode hors-ligne pour accélérer les builds suivants.
RUN mvn dependency:go-offline -B

# Copie le code source dans l'image builder.
COPY src ./src
# Compile et package l'application en JAR sans exécuter les tests.
RUN mvn clean package -DskipTests

# ── Stage 2: Run ────────────────────────────────
# Image runtime légère basée sur Java 17 JRE Alpine.
FROM eclipse-temurin:17-jre-alpine

# Définit le répertoire de travail à /app dans l'image finale.
WORKDIR /app

# Copie le JAR construit depuis l'image builder vers l'image finale.
COPY --from=builder /app/target/*.jar app.jar

# Expose le port 8083 pour l'application backend.
EXPOSE 8083

# Commande de démarrage de l'application Java.
ENTRYPOINT ["java", "-jar", "app.jar"]